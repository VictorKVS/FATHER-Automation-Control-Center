{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DemoWorkspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureVersion",
    "dataStatus",
    "objects",
    "boards",
    "workspace"
  ],
  "properties": {
    "fixtureVersion": {
      "type": "string",
      "minLength": 1
    },
    "dataStatus": {
      "const": "DEMO"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "father-object.schema.json"
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "$ref": "board-state.schema.json"
      }
    },
    "workspace": {
      "$ref": "workspace-state.schema.json"
    }
  }
}