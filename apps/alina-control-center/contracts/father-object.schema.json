{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.local/contracts/father-object.schema.json",
  "title": "FatherObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "version",
    "dataStatus",
    "provenanceRefs",
    "relationRefs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "dataStatus": {
      "enum": [
        "REAL",
        "DEMO",
        "PLANNED",
        "UNAVAILABLE",
        "STALE",
        "UNKNOWN"
      ]
    },
    "provenanceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}